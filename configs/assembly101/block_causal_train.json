{
  "runtime": {
    "seed": 1538574472,
    "device": "auto",
    "deterministic_cudnn": true
  },
  "experiment": {
    "dataset": "assembly101",
    "split": "coarse_action_id",
    "run_name": "block_causal_train"
  },
  "paths": {
    "labels_root": "{data_root}/assembly101_annotations",
    "features_root": "{data_root}",
    "output_root": "{output_root}"
  },
  "data": {
    "feature_source": "tsm_lmdb_stride8_archive",
    "features_dim": 1408,
    "input_features_dim": 2048,
    "num_classes": null,
    "sample_rate": 1,
    "frame_stride": 8,
    "target_fps": 3.75,
    "source_fps": 30,
    "lmdb_subdir": "db_TSM_features",
    "archive_path": "{data_root}/assembly101_small/assembly101_tsm_stride8.pt",
    "max_take_len": 32,
    "val_max_take_len": null,
    "train_manifest": "assembly101_coarse_segments.csv",
    "val_manifest": "assembly101_coarse_segments.csv",
    "train_split": "train",
    "val_split": "val",
    "label_column": "action_id",
    "video_path_column": "video_path",
    "split_column": "official_split",
    "sample_id_column": "sample_uid",
    "action_type_column": "action_type",
    "take_key_mode": "action_type_video_view",
    "start_frame_column": "start_frame",
    "end_frame_column": "end_frame",
    "source_fps_column": "annotation_fps"
  },
  "model": {},
  "ssl": {
    "enc_depth": 4,
    "pred_depth": 2,
    "ema_momentum": 0.999,
    "accumulation_steps": 2,
    "student_encoder_attention": "block_causal",
    "mask_ratio": 0.6,
    "directional_mask_prob": 0.0,
    "directional_future_mask_ratio": 0.75,
    "directional_min_context_clips": 1,
    "directional_min_future_clips": 1,
    "rope_mode": "1d_flat",
    "student_encoder_block_size": 64,
    "enc_heads": 16,
    "pred_heads": 16
  },
  "train": {
    "num_epochs": 1000,
    "batch_size": 24,
    "val_batch_size": 24,
    "lr": 0.0001,
    "lr_milestones": [
      500
    ],
    "lr_gamma": 0.1,
    "val_every": 20,
    "ckpt_metric": "lin_combined"
  },
  "probe": {
    "mode": "linear",
    "train_max_take_len": null,
    "linear_probe_pool": false,
    "every": 20,
    "epochs": 30,
    "lr_lin": 0.001,
    "lin_lr_milestones": [
      5,
      15
    ],
    "weight_decay": 0
  },
  "wandb": {
    "use_wandb": false
  },
  "loader": {
    "backend": "assembly101_frame_flat_archive",
    "cache_in_memory": true,
    "preload_in_parent": true
  },
  "init": {},
  "evaluation": {
    "temporal_probe_kind": "linear",
    "linear_only": true,
    "select_metric": "lin_combined",
    "probe_feature_source": "student",
    "batch_size": 24,
    "val_batch_size": 1
  },
  "roots": {
    "data_root": "data",
    "checkpoint_root": "checkpoints/weights",
    "output_root": "outputs"
  }
